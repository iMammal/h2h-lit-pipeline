{
  "schema_version": "1.0.0",
  "control_set_id": "semantic-scholar-bulk-boolean-controls",
  "control_set_version": "0.2.0-preproduction",
  "target_source": "SemanticScholar",
  "endpoint_mode": "bulk",
  "purpose": "endpoint_boolean_semantics_only",
  "production_identification_gate": "bulk_boolean_semantics",
  "automatic_mode_switching": false,
  "creates_production_occurrences": false,
  "contributes_prisma_counts": false,
  "term_rationale": "Common stable terms are used only to expose conjunction, disjunction, and grouping behavior; they are not STAR concepts or corpus observations.",
  "probes": [
    {"probe_id": "atomic-a", "expression": "visualization", "role": "atomic_a"},
    {"probe_id": "atomic-b", "expression": "biology", "role": "atomic_b"},
    {"probe_id": "a-and-b", "expression": "visualization AND biology", "role": "conjunction"},
    {"probe_id": "a-or-b", "expression": "visualization OR biology", "role": "disjunction"},
    {"probe_id": "grouped-left", "expression": "visualization AND (biology OR interactive)", "role": "grouping_equivalence_left"},
    {"probe_id": "grouped-right", "expression": "(visualization AND biology) OR (visualization AND interactive)", "role": "grouping_equivalence_right"}
  ],
  "assertions": [
    {"assertion_id": "and-not-greater-than-a", "left_probe_id": "a-and-b", "relation": "less_than_or_equal", "right_probe_id": "atomic-a"},
    {"assertion_id": "and-not-greater-than-b", "left_probe_id": "a-and-b", "relation": "less_than_or_equal", "right_probe_id": "atomic-b"},
    {"assertion_id": "or-not-less-than-a", "left_probe_id": "a-or-b", "relation": "greater_than_or_equal", "right_probe_id": "atomic-a"},
    {"assertion_id": "or-not-less-than-b", "left_probe_id": "a-or-b", "relation": "greater_than_or_equal", "right_probe_id": "atomic-b"},
    {"assertion_id": "equivalent-grouping-count", "left_probe_id": "grouped-left", "relation": "equal", "right_probe_id": "grouped-right"}
  ]
}
